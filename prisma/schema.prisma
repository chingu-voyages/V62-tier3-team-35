generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  username      String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  learningPaths LearningPath[]
}

model LearningPath {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  careerGoal   String       @map("career_goal") @db.VarChar(300)
  skillLevel   SkillLevel   @map("skill_level")
  skills       String[]     @default([])
  hoursPerWeek Int          @map("hours_per_week")
  learningPace LearningPace @map("learning_pace")
  status       PathStatus   @default(draft)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  user         User         @relation(fields: [userId], references: [id])
  steps        Step[]

  @@index([userId])
  @@map("learning_paths")
}

model Step {
  id             String       @id @default(uuid())
  learningPathId String       @map("learning_path_id")
  order          Int
  title          String       @db.VarChar(200)
  description    String
  estimatedTime  Int          @map("estimated_time")
  isCompleted    Boolean      @default(false) @map("is_completed")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  keyTopics      String?      @map("key_topics")
  icon           String?
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  topics         Topic[]

  @@unique([learningPathId, order])
  @@map("steps")
}

model Topic {
  id          String    @id @default(uuid())
  stepId      String    @map("step_id")
  name        String
  resources   Json
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  step        Step      @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("topics")
}

enum SkillLevel {
  beginner
  intermediate
  advanced
}

enum PathStatus {
  draft
  active
  completed
}

enum LearningPace {
  recommended
  accelerated
  relaxed
}
